# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored. Never commit real keys.
#
# This project uses its OWN Supabase project, separate from CompX Orbit.
# Nothing here should point at the Orbit database.
# ---------------------------------------------------------------------------

# Public URL of this site. Used in emails and the bKash callback.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shown in the header, emails and page titles.
NEXT_PUBLIC_BRAND_NAME=Subdealer

# ---------------------------------------------------------------------------
# Supabase — Project Settings -> API, in the NEW subdealer project
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Credential encryption
# ---------------------------------------------------------------------------
# AES-256-GCM key for sub_credentials.password_enc (openssl rand -hex 32).
# SERVER ONLY. Lose this and no stored password can be decrypted again, so
# keep a copy in a password manager. Production and Preview must share the
# same value or Preview cannot read production credentials.
CREDENTIAL_ENC_KEY=

# ---------------------------------------------------------------------------
# Daily expiry cron
# ---------------------------------------------------------------------------
# Vercel Cron sends this as `Authorization: Bearer <value>`.
CRON_SECRET=

# ---------------------------------------------------------------------------
# bKash (manual verification) — the number shown at checkout
# ---------------------------------------------------------------------------
NEXT_PUBLIC_BKASH_NUMBER=01XXXXXXXXX

# ---------------------------------------------------------------------------
# Email (Resend) — optional. Without it the app still works, emails are
# just skipped and logged to the server console.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Subdealer <onboarding@resend.dev>
SUPPORT_EMAIL=support@example.com

# Public WhatsApp community group invite link (footer button)
NEXT_PUBLIC_WHATSAPP_GROUP=https://chat.whatsapp.com/XXXXXXXXXXXXXXX

# Personal WhatsApp number for order fulfillment (digits only, intl format: 880...)
NEXT_PUBLIC_WHATSAPP_SUPPORT=8801XXXXXXXXX
